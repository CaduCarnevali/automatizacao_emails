# Email que fará os envios
EMAIL=

# Senha do email (use senha de aplicativo, não a senha da conta)
SENHA=

# Servidor SMTP (ex.: smtp.gmail.com)
SMTP_SERVER=

# Porta SMTP (ex.: 465 para SSL)
SMTP_PORT=

# TESTE ou PRODUCAO
MODO=TESTE

# Email para testes
EMAIL_TESTE=

# Pasta base onde estão as subpastas de cada cliente com os PDFs.
# Opcional — padrão: ~/Desktop/Sefip
BASE_PATH=
